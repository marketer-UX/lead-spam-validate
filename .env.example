# ── validate service ─────────────────────────────────────────────────────────────
# NODE_ENV=production enables the boot guard: without TOKEN_SECRET, API_KEYS and
# ALLOWED_ORIGINS the service refuses to start.
# NODE_ENV=production   (already set in the Dockerfile)
PORT=8787

# Optional canonical domain. Requests whose Host ends with CANONICAL_FROM_SUFFIX
# (your platform's default domain, e.g. .up.railway.app, .fly.dev, .onrender.com)
# get a 301 to CANONICAL_HOST — except /health, so platform health checks keep working.
# Only set this once every caller (webhooks!) uses the canonical domain: a 301 breaks POSTs.
CANONICAL_HOST=
CANONICAL_FROM_SUFFIX=

# HMAC secret for time-to-submit tokens (32+ random bytes, hex). TOKEN_SECRET_PREV keeps
# old tokens valid during a rotation.   openssl rand -hex 32
TOKEN_SECRET=
TOKEN_SECRET_PREV=
# Salt for hashing IPs in rate-limit keys (IPs are never stored in clear).
IP_SALT_SECRET=

# Server-to-server keys: id:key,id2:key2 (your backend, form handlers, admin tools).
API_KEYS=backend:CHANGE_ME
# Browser callers: exact origins or wildcards.
ALLOWED_ORIGINS=https://example.com,https://www.example.com

# ── Remote config + events (optional control plane) ─────────────────────────────
# With CONFIG_URL set, the service pulls global/site/form rules at boot, every
# CONFIG_POLL_S seconds and on POST /v1/admin/reload. If the endpoint fails, the last
# good config stays; if it was never loaded, the env values below apply.
CONFIG_URL=
# PII-free decision events (batched) for your own statistics. Empty = nothing collected.
EVENTS_URL=
# X-Api-Key sent to CONFIG_URL, EVENTS_URL and the optional lead PATCH endpoint.
CONTROL_API_KEY=
CONFIG_POLL_S=60
EVENTS_FLUSH_S=10

# ── Fallback / global defaults (apply without a remote config) ──────────────────
# observe = never block in the browser (hidden fields only) · enforce = block hard
# rejects · off = embed idle. Delivered via /v1/token → remote kill switch, no republish.
EMBED_MODE=observe
# strict: also block structurally invalid phone numbers / email addresses in enforce mode.
STRICT_CONTACT=false

# ── Stage 2 email verification (SMTP) ───────────────────────────────────────────
# none | aftership (the Go deep-verifier in ./deep-verifier) | reacher (AGPL — check the license)
EMAIL_VERIFIER_PROVIDER=none
DEEP_VERIFIER_URL=
DEEP_VERIFIER_KEY=
REACHER_URL=
REACHER_SECRET=
FROM_EMAIL=noreply@example.com
HELLO_NAME=verify.example.com
# Stage 1 MX lookup budget
MX_TIMEOUT_MS=1500

# ── Rate limits ─────────────────────────────────────────────────────────────────
# API abuse limits, plus submission limits (score signal only unless RATE_LIMIT_HARD=true).
RL_IP_PER_MIN=60
RL_KEY_PER_MIN=600
RL_SUBMIT_IP_10M=5
RL_SUBMIT_IP_24H=20
RL_SUBMIT_FREEMAIL_1H=3
RL_WEBHOOK_EMAIL_1H=3
RATE_LIMIT_HARD=false

# ── Webhooks ────────────────────────────────────────────────────────────────────
# Webflow: HMAC secret (x-webflow-signature) and/or a fallback query secret ?k=
WEBFLOW_WEBHOOK_SECRET=
WEBHOOK_FALLBACK_SECRET=
# false = forward everything (annotated with _validation), true = drop rejected submissions
WEBHOOK_ENFORCE=false
# Webflow API token (scope forms:write): junk that reached Webflow without the embed is
# deleted on sites in enforce mode. WEBFLOW_DELETE_REJECTED is the switch (default off).
WEBFLOW_API_TOKEN=
WEBFLOW_DELETE_REJECTED=false
# Calendly: personal access token (cancels junk bookings) + signing key of the webhook subscription
CALENDLY_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=

# ── Lead forwarding (optional) ──────────────────────────────────────────────────
# Per-site secrets: Webflow site id guard, honeypot field name, token + Origin for FORWARD_URL.
SITES_JSON={"demo":{"site_id":"0123456789abcdef01234567","honeypot":"company_url_confirm","forward_token":"CHANGE_ME","forward_origin":"https://example.com"}}
# Where validated webhook submissions are POSTed (your CRM, lead store, automation endpoint).
FORWARD_URL=

# ── Misc ────────────────────────────────────────────────────────────────────────
DEEP_QUEUE_MAX=500
DEEP_CONCURRENCY=2
# Disposable-domain list refresh (GitHub raw), `off` to disable
DISPOSABLE_REFRESH_URL=
DISPOSABLE_REFRESH_HOURS=24
LOG_LEVEL=info
DEBUG=false
