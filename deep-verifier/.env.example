# deep-verifier (stage 2) - copy to .env and fill in.

# HTTP port. Most platforms inject this; locally 8080 is fine.
PORT=8080

# Shared secret for X-Api-Key. Same value as DEEP_VERIFIER_KEY in the
# Node service. An empty key refuses to boot unless ALLOW_NO_AUTH=1.
API_KEY=change-me
# ALLOW_NO_AUTH=1   # local development only

# MAIL FROM of the SMTP probe. Must be a real address on a domain whose SPF
# covers this host, otherwise many MX drop the handshake.
FROM_EMAIL=noreply@example.com

# EHLO name. Must match the PTR record of the outbound IP.
HELLO_NAME=verify.example.com

# 1 = JSON log lines. Addresses are never logged, only domain + sha256 prefix.
LOG_JSON=1
